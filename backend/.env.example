# SSK Natural Gold - Backend Environment Variables Example
# Copy this file to .env and configure for your environment

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/ssk_natural_gold?schema=public"

# Authentication & Security
JWT_SECRET="your_strong_jwt_secret_key_here"
ADMIN_INITIAL_EMAIL="admin@ssknaturalgold.com"
ADMIN_INITIAL_PASSWORD="ChangeThisPassword123!"
