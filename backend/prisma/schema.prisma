// Prisma Schema for SSK Natural Gold
// Robust relational models for Wood-Pressed Oil E-Commerce platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS: Database-Level Status and Role Integrity
// ─────────────────────────────────────────────────────────────────────────────
enum OrderStatus {
  REQUESTED
  UNDER_REVIEW
  AWAITING_CUSTOMER_ACCEPTANCE
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAYMENT_INSTRUCTIONS_SENT
  PAYMENT_REPORTED
  VERIFIED
  COD_PENDING
  COD_COLLECTED
  REFUNDED
}

enum PaymentPreference {
  UPI
  COD
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}

enum ActorType {
  CUSTOMER
  ADMIN
  SYSTEM
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. Administrator Account Model
// ─────────────────────────────────────────────────────────────────────────────
model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)
  tokenVersion Int       @default(1) // Incremented on password rotation to invalidate existing JWTs
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@map("admin_users")
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. Product Catalog Models
// ─────────────────────────────────────────────────────────────────────────────
model Product {
  id                  String           @id @default(uuid())
  slug                String           @unique
  category            String           // groundnut, sesame, coconut
  nameEn              String
  nameTa              String
  botanicalName       String?
  taglineEn           String?
  taglineTa           String?
  descriptionEn       String
  descriptionTa       String
  seedOrigin          String?
  extractionProcessEn String?
  extractionProcessTa String?
  woodType            String?          // e.g. "Vaagai Wood Mortar"
  fssaiLicense        String?
  rating              Decimal          @default(5.0) @db.Decimal(3, 2)
  reviewCount         Int              @default(0)
  primaryImage        String?
  lifestyleImage      String?
  galleryImages       String[]         @default([])
  featured            Boolean          @default(true)
  inStock             Boolean          @default(true)
  isArchived          Boolean          @default(false)
  isDemoProduct       Boolean          @default(true) // Identifies sample catalog data
  variants            ProductVariant[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([category])
  @@index([slug])
  @@index([inStock])
  @@index([isArchived])
  @@map("products")
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String      @unique
  volume        String      // "500 ml", "1 Litre", "5 Litre Tin", "15 Litre Tin"
  volumeMl      Int
  containerType String      // "Food-Grade PET Bottle", "Reinforced Mill Tin"
  mrp           Decimal     @db.Decimal(10, 2)
  price         Decimal     @db.Decimal(10, 2)
  stock         Int         @default(0)
  reservedStock Int         @default(0) // Inventory reserved for pending UPI payments
  isDefault     Boolean     @default(false)
  orderItems    OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. Order & Fulfillment Models
// ─────────────────────────────────────────────────────────────────────────────
model OrderRequest {
  id                     String            @id @default(uuid())
  orderNumber            String            @unique // e.g. SSK-REQ-2026-1042
  status                 OrderStatus       @default(REQUESTED)
  paymentPreference      PaymentPreference
  paymentStatus          PaymentStatus     @default(UNPAID)
  subtotal               Decimal           @db.Decimal(10, 2)
  deliveryFee            Decimal           @default(0.00) @db.Decimal(10, 2)
  isDeliveryFeeConfirmed Boolean           @default(false)
  discount               Decimal           @default(0.00) @db.Decimal(10, 2)
  total                  Decimal           @db.Decimal(10, 2)

  // Guest Customer Details
  customerName           String
  customerPhone          String            // 10-digit sanitized mobile number
  customerEmail          String?
  addressLine1           String
  addressLine2           String?
  landmark               String?
  city                   String
  state                  String
  pincode                String
  deliveryInstructions   String?

  // Courier & Dispatch Details
  courier                String?
  awbNumber              String?
  estimatedDeliveryDate  String?

  // Payment Verification Fields
  customerUtr            String?
  paymentReportedAt      DateTime?
  paymentVerifiedAt      DateTime?
  codCollectedAt         DateTime?

  // Explicit Refund Tracking Fields (Full refunds only)
  refundAmount           Decimal?          @db.Decimal(10, 2)
  refundReason           String?
  refundReference        String?
  refundedAt             DateTime?

  // Inventory Reservation Tracking
  inventoryState         String            @default("NONE") // NONE, RESERVED, DEDUCTED
  isStockDeducted        Boolean           @default(false)
  reservationExpiresAt   DateTime?

  // Internal Audit & Decline Notes
  adminNotes             String?
  customerDeclineReason  String?

  // Relationships
  items                  OrderItem[]
  statusLogs             OrderStatusLog[]

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([orderNumber])
  @@index([customerPhone])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentPreference])
  @@index([inventoryState])
  @@index([createdAt])
  @@map("order_requests")
}

model OrderItem {
  id             String          @id @default(uuid())
  orderRequestId String
  orderRequest   OrderRequest    @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  productId      String?
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Immutable historical snapshots (preserved even if product/variant is modified or archived)
  productNameEn  String
  productNameTa  String
  variantVolume  String
  unitPrice      Decimal         @db.Decimal(10, 2)
  unitMrp        Decimal         @db.Decimal(10, 2)
  quantity       Int
  subtotal       Decimal         @db.Decimal(10, 2)
  image          String?

  createdAt      DateTime        @default(now())

  @@index([orderRequestId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusLog {
  id                String         @id @default(uuid())
  orderRequestId    String
  orderRequest      OrderRequest   @relation(fields: [orderRequestId], references: [id], onDelete: Cascade)
  fromStatus        OrderStatus?
  toStatus          OrderStatus
  fromPaymentStatus PaymentStatus?
  toPaymentStatus   PaymentStatus?
  actor             ActorType      // CUSTOMER, ADMIN, SYSTEM
  notes             String?
  createdAt         DateTime       @default(now())

  @@index([orderRequestId])
  @@index([createdAt])
  @@map("order_status_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. Business Configuration Model
// ─────────────────────────────────────────────────────────────────────────────
model BusinessSettings {
  id                       String   @id @default(uuid())
  key                      String   @unique @default("primary")
  businessName             String   @default("SSK Natural Gold")
  businessNameTa           String   @default("எஸ்.எஸ்.கே நேச்சுரல் கோல்ட்")
  fssaiLicense             String   @default("22426293000431")
  fssaiVerified            Boolean  @default(false)
  merchantUpiId            String   @default("ssknaturalgold@okhdfcbank")
  merchantPayeeName        String   @default("SSK Natural Gold")
  upiVerified              Boolean  @default(false)
  whatsappPhone            String   @default("+91 9994072837")
  supportPhone             String   @default("+91 9994072837")
  contactEmail             String   @default("support@ssknaturalgold.com")
  millAddress              String   @default("Mettupatti Main Road, Tenkasi District, Tamil Nadu — 627811")
  defaultCourierFee        Decimal  @default(50.00) @db.Decimal(10, 2)
  freeDeliveryThreshold    Decimal  @default(1500.00) @db.Decimal(10, 2)
  codEnabled               Boolean  @default(true)
  codMaxLimit              Decimal  @default(5000.00) @db.Decimal(10, 2)
  isDemoConfiguration      Boolean  @default(true)
  isDemoCatalogue          Boolean  @default(true)
  upiPaymentWindowMinutes  Int      @default(1440) // 24-hour default payment window

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("business_settings")
}
